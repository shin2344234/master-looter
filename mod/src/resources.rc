// The data tables are built into the plugin so it works as a single file
// under any mod manager. A MasterLooter.items.tsv, .creatures.tsv or .nodes.tsv
// next to the plugin overrides the built-in copy (see Paths::ReadDataText).
#include <windows.h>

ML_ITEMS_TSV     RCDATA "../data/MasterLooter.items.tsv"
ML_CREATURES_TSV RCDATA "../data/MasterLooter.creatures.tsv"
ML_NODES_TSV     RCDATA "../data/MasterLooter.nodes.tsv"

// Translations ship inside the plugin for the same reason, since the mod
// manager package is the .asi on its own. The name is ML_LANG_ plus the
// language in capitals with its hyphen as an underscore, because a resource
// identifier cannot hold a hyphen and quoting one here would make the quotes
// part of the name. Text::Load builds it that way, and a file of the matching
// name next to the plugin still wins. Keep kBuiltIn in text.cpp in step with
// this list.
ML_LANG_ZH_CN    RCDATA "../data/MasterLooter.zh-cn.txt"
ML_LANG_ZH_TW    RCDATA "../data/MasterLooter.zh-tw.txt"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,3,0,0
 PRODUCTVERSION 1,3,0,0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "Master Looter for Crimson Desert"
            VALUE "FileVersion",      "1.3.0"
            VALUE "InternalName",     "MasterLooter"
            VALUE "OriginalFilename", "MasterLooter.asi"
            VALUE "ProductName",      "Master Looter"
            VALUE "ProductVersion",   "1.3.0"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Seth. MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
