# game data extracted from the PAZ archives (regenerate with the paz tools, see README)
extracted/
# third-party repos cloned for reference (crimson-desert-unpacker, CrimsonDesertModdingTools, crimson-rs, pycrimson)
tools/
__pycache__/
*.pyc
mod/build/
mod/dist/
# generated from the extracted game tables; they carry the game's own text, so they stay local
data/items_tagged.csv
data/items_tagged.json
data/character_drops.csv
data/dropsets.json
data/dropset_entries.csv
data/dropset_sources.csv
data/item_drop_sets.csv
data/item_sources.csv
data/gimmick_drops.csv
data/sources.json
data/item_groups_tree.txt
data/unmapped_groups.txt
# raw session captures from the ore-yield investigation; FINDINGS.md transcribes
# what mattered and the logs are large, so they stay local
docs/ore-investigation/logs/
# a third-party review dump with bundled wheels, kept for reference, not shipped
codex/

# Claude Code: the standing brief and any tooling state stay on this machine
CLAUDE.md
.claude/
.mcp.json

# API keys. keys.local.env is the one the scripts read; the rest of these
# patterns are here so a key dropped anywhere obvious cannot be committed by
# accident. keys.local.env.example is tracked and holds no key.
keys.local.env
*.local.env
.env
.env.*
!*.example
*apikey*
*api-key*
*api_key*
secrets.*
!secrets.*.example
build-nowrap/
